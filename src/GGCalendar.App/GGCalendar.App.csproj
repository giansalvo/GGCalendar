<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<Version>1.0.1</Version>
		<AssemblyVersion>1.0.1.0</AssemblyVersion>
		<FileVersion>1.0.1.0</FileVersion>
		<InformationalVersion>1.0.1</InformationalVersion>
		<ApplicationIcon>Assets\GGCalendar.ico</ApplicationIcon>
		<Product>GGCalendar</Product>
		<Authors>Giansalvo Gusinu</Authors>
		<Company>Giansalvo Gusinu</Company>
		<Copyright>© 2026 Giansalvo Gusinu</Copyright>
		<Description>Calendario per Windows con sincronizzazione Google Calendar</Description>
	</PropertyGroup>

	<ItemGroup>
		<AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
			<_Parameter1>BuildDate</_Parameter1>
			<_Parameter2>$([System.DateTime]::Now.ToString('yyyy-MM-dd'))</_Parameter2>
		</AssemblyAttribute>
	</ItemGroup>

	<ItemGroup>
		<Folder Include="Models\" />
		<AssemblyAttribute Include="System.Runtime.Versioning.SupportedOSPlatformAttribute">
			<_Parameter1>windows</_Parameter1>
		</AssemblyAttribute>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.1.4" />
		<PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
		<PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
			<IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
			<PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
		</PackageReference>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
		<PackageReference Include="NAudio" Version="2.2.1" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\GGCalendar.Core\GGCalendar.Core.csproj" />
		<ProjectReference Include="..\GGCalendar.Data\GGCalendar.Data.csproj" />
		<ProjectReference Include="..\GGCalendar.Providers.Google\GGCalendar.Providers.Google.csproj" />
	</ItemGroup>
</Project>