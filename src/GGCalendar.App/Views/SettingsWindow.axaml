<Window xmlns:loc="using:GGCalendar.App.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        x:Class="GGCalendar.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="560" Height="780" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:T main.settings}">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,0" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,16">
        <Grid DockPanel.Dock="Bottom" ColumnDefinitions="*,Auto,Auto" Margin="0,12,0,0">
            <TextBlock Text="{Binding Error}" Foreground="#D93025" VerticalAlignment="Center" TextWrapping="Wrap" />
            <Button AutomationProperties.AutomationId="Settings.Cancel" Grid.Column="1" Content="{loc:T common.cancel}" Margin="0,0,8,0" Click="OnCancel" />
            <Button AutomationProperties.AutomationId="Settings.Save" Grid.Column="2" Content="{loc:T common.save}" Classes="accent" IsDefault="True" Click="OnSave" />
        </Grid>

        <ScrollViewer Name="SettingsScroll">
            <StackPanel Spacing="10" Margin="0,0,12,0">
                <TextBlock Classes="section" Text="{loc:T settings.language_section}" Margin="0" />
                <Grid ColumnDefinitions="220,*">
                    <TextBlock Text="{loc:T settings.language_label}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.SelectedLanguage" Grid.Column="1" ItemsSource="{Binding LanguageOptions}" SelectedItem="{Binding SelectedLanguage}" MinWidth="200">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:LanguageOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
                <TextBlock Classes="section" Text="{loc:T settings.calendar}" />
                <Grid ColumnDefinitions="220,*" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="{loc:T settings.day_start}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.DayStartHour" Grid.Column="1" ItemsSource="{Binding Hours}" SelectedItem="{Binding DayStartHour}" MinWidth="100" />
                    <TextBlock Grid.Row="1" Text="{loc:T settings.day_end}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.DayEndHour" Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Hours}" SelectedItem="{Binding DayEndHour}" MinWidth="100" />
                    <TextBlock Grid.Row="2" Text="{loc:T settings.week_starts}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.FirstDayOfWeek" Grid.Row="2" Grid.Column="1" ItemsSource="{Binding Weekdays}" SelectedItem="{Binding FirstDayOfWeek}" MinWidth="160">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:WeekdayOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="3" Text="{loc:T settings.default_duration}" VerticalAlignment="Center" />
                    <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding DefaultEventMinutes}" Minimum="5" Maximum="1440" Increment="15" FormatString="0" HorizontalAlignment="Left" Width="140" />
                </Grid>
                <CheckBox AutomationProperties.AutomationId="Settings.HideOutsideHours" Content="{loc:T settings.hide_outside_hours}" IsChecked="{Binding HideOutsideHours}" />
                <CheckBox AutomationProperties.AutomationId="Settings.ShowWeekNumbers" Content="{loc:T settings.week_numbers}" IsChecked="{Binding ShowWeekNumbers}" />
                <CheckBox AutomationProperties.AutomationId="Settings.Use24HourClock" Content="{loc:T settings.clock_24h}" IsChecked="{Binding Use24HourClock}" />
                <CheckBox AutomationProperties.AutomationId="Settings.DimPastEvents" Content="{loc:T settings.dim_past}" IsChecked="{Binding DimPastEvents}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{loc:T settings.theme}" VerticalAlignment="Center" Width="220" />
                    <ComboBox AutomationProperties.AutomationId="Settings.ThemeIndex" SelectedIndex="{Binding ThemeIndex}" MinWidth="160">
                        <ComboBoxItem Content="{loc:T settings.theme_system}" />
                        <ComboBoxItem Content="{loc:T settings.theme_light}" />
                        <ComboBoxItem Content="{loc:T settings.theme_dark}" />
                    </ComboBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <TextBlock Text="{loc:T settings.snap}" VerticalAlignment="Center" Width="220" />
                    <ComboBox AutomationProperties.AutomationId="Settings.SnapMinutes" ItemsSource="{Binding SnapOptions}" SelectedItem="{Binding SnapMinutes}" MinWidth="100" />
                </StackPanel>

                <TextBlock Classes="section" Text="{loc:T settings.new_event_guest_permissions}" />
                <CheckBox AutomationProperties.AutomationId="Settings.DefaultGuestsCanModify" Content="{loc:T guests.modify}" IsChecked="{Binding DefaultGuestsCanModify}" />
                <CheckBox AutomationProperties.AutomationId="Settings.DefaultGuestsCanInvite" Content="{loc:T guests.invite}" IsChecked="{Binding DefaultGuestsCanInvite}" />
                <CheckBox AutomationProperties.AutomationId="Settings.DefaultGuestsCanSeeList" Content="{loc:T guests.see_list}" IsChecked="{Binding DefaultGuestsCanSeeList}" />

                <TextBlock Classes="section" Text="{loc:T settings.second_zone}" />
                <TextBlock Classes="hint" Text="{loc:T settings.second_zone_hint}" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="{loc:T settings.second_zone_pick}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.SecondaryTimeZone" Grid.Column="1" ItemsSource="{Binding SecondaryTimeZones}" SelectedItem="{Binding SecondaryTimeZone}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:TimeZoneOption"><TextBlock Text="{Binding Name}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <TextBlock Grid.Row="1" Text="{loc:T settings.second_zone_label}" VerticalAlignment="Center" IsVisible="{Binding HasSecondaryZone}" />
                    <TextBox AutomationProperties.AutomationId="Settings.SecondaryTimeZoneLabel" Grid.Row="1" Grid.Column="1" Text="{Binding SecondaryTimeZoneLabel}" MaxLength="12"
                             PlaceholderText="{Binding SecondaryLabelPlaceholder}" Width="160" HorizontalAlignment="Left" IsVisible="{Binding HasSecondaryZone}" />
                    <TextBlock Grid.Row="2" Grid.Column="1" Classes="hint" Text="{Binding SecondaryLabelHint}" IsVisible="{Binding HasSecondaryZone}" />
                </Grid>

                <TextBlock Classes="section" Text="{loc:T settings.google_accounts}" />
                <ItemsControl ItemsSource="{Binding GoogleAccounts}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <Grid ColumnDefinitions="*,Auto" Margin="0,2">
                                <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                                <Button Grid.Column="1" Content="{loc:T settings.disconnect}" Padding="10,3"
                                        AutomationProperties.AutomationId="Settings.Disconnect" Tag="{Binding}" Click="OnDisconnectAccount" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button Content="{loc:T settings.add_account}" Command="{Binding AddGoogleAccountCommand}" IsEnabled="{Binding !IsSigningIn}" />
                    <Button Content="{loc:T common.cancel}" Command="{Binding CancelSignInCommand}" IsVisible="{Binding IsSigningIn}" />
                    <Button Content="{loc:T settings.resync_all}" Click="OnResyncAll" IsEnabled="{Binding !IsSigningIn}"
                            ToolTip.Tip="{loc:T settings.resync_tip}" />
                </StackPanel>
                <TextBlock Text="{Binding GoogleStatus}" TextWrapping="Wrap" Opacity="0.75" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Text="{loc:T settings.sync}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.SyncIntervalIndex" Grid.Column="1" ItemsSource="{Binding SyncIntervalLabels}" SelectedIndex="{Binding SyncIntervalIndex}" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock Classes="section" Text="{loc:T main.public_calendars}" />
                <Grid ColumnDefinitions="140,*">
                    <TextBlock Text="{loc:T settings.sub_interval}" VerticalAlignment="Center" TextWrapping="Wrap" />
                    <ComboBox AutomationProperties.AutomationId="Settings.SubscriptionIntervalIndex" Grid.Column="1" ItemsSource="{Binding SubscriptionIntervalLabels}" SelectedIndex="{Binding SubscriptionIntervalIndex}" HorizontalAlignment="Stretch" />
                </Grid>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button AutomationProperties.AutomationId="Settings.SubRefreshNow" Content="{loc:T settings.sub_refresh_now}" Command="{Binding RefreshSubscriptionsCommand}" IsEnabled="{Binding !IsRefreshingSubscriptions}" />
                    <TextBlock AutomationProperties.AutomationId="Settings.SubStatus" Text="{Binding SubscriptionStatus}" VerticalAlignment="Center" Opacity="0.75" TextWrapping="Wrap" />
                </StackPanel>
                <TextBlock Classes="section" Text="{loc:T settings.notifications}" />
                <CheckBox AutomationProperties.AutomationId="Settings.NotificationsEnabled" Content="{loc:T settings.notifications_enabled}" IsChecked="{Binding NotificationsEnabled}" />
                <Grid ColumnDefinitions="140,*,Auto,Auto" RowDefinitions="Auto,Auto" RowSpacing="8">
                    <TextBlock Text="{loc:T settings.default_sound}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.DefaultSound" Grid.Column="1" ItemsSource="{Binding Sounds}" SelectedItem="{Binding DefaultSound}" HorizontalAlignment="Stretch">
                        <ComboBox.ItemTemplate>
                            <DataTemplate x:DataType="vm:SoundOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <Button Grid.Column="2" Content="▶" Margin="6,0,0,0" Command="{Binding PreviewDefaultSoundCommand}" ToolTip.Tip="{loc:T common.listen}" />
                    <Button Grid.Column="3" Content="📂" Margin="4,0,0,0" Click="OnBrowseSound" ToolTip.Tip="{loc:T common.choose_audio}" />
                    <TextBlock Grid.Row="1" Text="{loc:T settings.volume}" VerticalAlignment="Center" />
                    <Slider Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Minimum="0" Maximum="100" Value="{Binding ReminderVolumePercent}" />
                </Grid>

                <TextBlock Classes="section" Text="{loc:T settings.advanced_section}" />
                <Expander Name="OauthExpander" Header="{loc:T settings.oauth_advanced}">
                    <StackPanel Spacing="8" Margin="0,8,0,0">
                        <TextBlock TextWrapping="Wrap" Opacity="0.7" FontSize="12"
                                   Text="{loc:T settings.oauth_hint}" />
                        <TextBox PlaceholderText="{loc:T settings.client_id}" Text="{Binding GoogleClientId}" />
                        <TextBox PlaceholderText="{loc:T settings.client_secret}" Text="{Binding GoogleClientSecret}" PasswordChar="●" />
                    </StackPanel>
                </Expander>

                <!-- Ollama (local model) section hidden: not used by any feature yet and not needed for the Microsoft Store version.
                <TextBlock Classes="section" Text="{loc:T settings.ollama}" />
                <Grid ColumnDefinitions="140,*,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <TextBlock Text="{loc:T settings.ollama_url}" VerticalAlignment="Center" />
                    <TextBox Grid.Column="1" Text="{Binding OllamaUrl}" />
                    <Button Grid.Column="2" Content="{loc:T settings.ollama_refresh}" Margin="8,0,0,0" Command="{Binding RefreshModelsCommand}" />
                    <TextBlock Grid.Row="1" Text="{loc:T settings.ollama_model}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.OllamaModel" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Models}" SelectedItem="{Binding OllamaModel}" HorizontalAlignment="Stretch" />
                    <TextBlock Grid.Row="2" Text="{loc:T settings.ollama_fallback}" VerticalAlignment="Center" />
                    <ComboBox AutomationProperties.AutomationId="Settings.OllamaFallbackModel" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2" ItemsSource="{Binding Models}" SelectedItem="{Binding OllamaFallbackModel}" HorizontalAlignment="Stretch" />
                </Grid>
                <TextBlock Text="{Binding OllamaStatus}" Opacity="0.7" TextWrapping="Wrap" />
                -->
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
