<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        x:Class="GGCalendar.App.Views.EventEditWindow"
        x:DataType="vm:EventEditViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="1080" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Header}">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1A73E8" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,16,24,16">
        <!-- Header: title, save, other actions -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto" Margin="0,0,0,12">
            <TextBox Name="TitleBox" Text="{Binding Title}" PlaceholderText="Aggiungi titolo" FontSize="22" Margin="0,0,16,0" />
            <Button Grid.Column="1" Content="Salva" Classes="accent" CornerRadius="18" Padding="26,8" IsDefault="True" Click="OnSave" />
            <Button Grid.Column="2" Content="Altre azioni  ▾" Classes="link" Margin="8,0,0,0">
                <Button.Flyout>
                    <MenuFlyout Placement="BottomEdgeAlignedRight">
                        <MenuItem Header="Esporta come file .ics…" Click="OnExport" />
                        <MenuItem Header="Elimina evento" Click="OnDelete" IsVisible="{Binding !IsNew}" />
                        <MenuItem Header="Annulla modifiche" Click="OnCancel" />
                    </MenuFlyout>
                </Button.Flyout>
            </Button>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="#D93025" Margin="0,8,0,0"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Date / time -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker SelectedDate="{Binding StartDate}" FirstDayOfWeek="Monday" />
                <TimePicker SelectedTime="{Binding StartTime}" IsVisible="{Binding IsTimed}" MinuteIncrement="5"
                            ClockIdentifier="{Binding Use24Hour, Converter={x:Static vm:ClockConverter.Instance}}" />
                <TextBlock Text="–" VerticalAlignment="Center" />
                <TimePicker SelectedTime="{Binding EndTime}" IsVisible="{Binding IsTimed}" MinuteIncrement="5"
                            ClockIdentifier="{Binding Use24Hour, Converter={x:Static vm:ClockConverter.Instance}}" />
                <CalendarDatePicker SelectedDate="{Binding EndDate}" FirstDayOfWeek="Monday" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="Tutto il giorno" IsChecked="{Binding IsAllDay}" />
                <ComboBox ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding Recurrence}" MinWidth="240" DisplayMemberBinding="{ReflectionBinding Label}" />
                <TextBlock Text="{Binding TimeZoneText}" Classes="hint" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,24,320">
            <!-- Details -->
            <ScrollViewer>
                <StackPanel Spacing="14" Margin="0,0,12,0">
                    <!-- Meet -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <TextBlock Classes="icon" Text="📹" />
                        <CheckBox IsChecked="{Binding AddMeet}" Content="Aggiungi videoconferenza di Google Meet" />
                    </StackPanel>
                    <StackPanel Margin="28,-8,0,0" IsVisible="{Binding AddMeet}" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMeetLink}">
                            <TextBox Text="{Binding MeetLink}" IsReadOnly="True" Width="320" />
                            <Button Content="Copia" Click="OnCopyMeet" />
                        </StackPanel>
                        <TextBlock Classes="hint" IsVisible="{Binding !HasMeetLink}"
                                   Text="Il link Meet viene generato da Google quando l'evento è salvato in un calendario Google." />
                    </StackPanel>

                    <!-- Location -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <TextBlock Classes="icon" Text="📍" />
                        <TextBox Text="{Binding Location}" PlaceholderText="Aggiungi posizione" Width="480" />
                    </StackPanel>

                    <!-- Reminders -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <TextBlock Classes="icon" Text="🔔" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReminderItemViewModel">
                                        <WrapPanel Margin="0,0,0,8" ItemSpacing="8" LineSpacing="6" MaxWidth="520">
                                            <ComboBox ItemsSource="{x:Static vm:ReminderItemViewModel.Methods}" SelectedItem="{Binding Method}" Width="120">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReminderMethodOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="9999" FormatString="0" Width="110" />
                                            <ComboBox ItemsSource="{x:Static vm:ReminderItemViewModel.Units}" SelectedItem="{Binding Unit}" Width="120">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReminderUnitOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPopup}">
                                                <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding Sound}" Width="230">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SoundOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Content="▶" Click="OnPreviewSound" ToolTip.Tip="Ascolta" />
                                                <Button Content="📂" Click="OnBrowseSound" ToolTip.Tip="Scegli un file audio (mp3, wav…)" />
                                            </StackPanel>
                                            <Button Content="✕" Background="Transparent" Click="OnRemoveReminder" ToolTip.Tip="Rimuovi" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="Aggiungi notifica" Classes="link" Command="{Binding AddReminderCommand}" IsEnabled="{Binding CanAddReminder}" Padding="0" />
                            <TextBlock Classes="hint" Text="Le notifiche email sono inviate da Google Calendar; notifiche e sveglie vengono mostrate in basso a destra da GGCalendar mentre è in esecuzione. La sveglia suona finché non viene spenta." />
                        </StackPanel>
                    </StackPanel>

                    <!-- Calendar + color -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="📅" />
                        <ComboBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}" MinWidth="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding AccountName}" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding EventColor}" MinWidth="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Hex, TargetNullValue=#888888}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Availability / visibility -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="💼" />
                        <ComboBox ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding Availability}" MinWidth="140" DisplayMemberBinding="{ReflectionBinding Label}" />
                        <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding Visibility}" MinWidth="200" DisplayMemberBinding="{ReflectionBinding Label}" />
                    </StackPanel>

                    <!-- Description -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <TextBlock Classes="icon" Text="≡" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <TextBox Text="{Binding Description}" PlaceholderText="Aggiungi descrizione" AcceptsReturn="True" TextWrapping="Wrap"
                                 Width="640" MinHeight="150" />
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Column="1" Width="1" Fill="#33888888" HorizontalAlignment="Center" />

            <!-- Guests -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="Invitati" FontSize="15" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewAttendee}" PlaceholderText="Aggiungi invitati (email)" KeyDown="OnAttendeeKeyDown" />
                        <Button Grid.Column="1" Content="＋" Margin="6,0,0,0" Command="{Binding AddAttendeeCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Attendees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttendeeViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <CheckBox Grid.Column="1" Content="Facoltativo" IsChecked="{Binding IsOptional}" FontSize="12" />
                                    <Button Grid.Column="2" Content="✕" Background="Transparent" Click="OnRemoveAttendee" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4" IsVisible="{Binding HasAttendees}">
                        <CheckBox Content="Invia email di invito al salvataggio" IsChecked="{Binding SendInvites}" />
                        <TextBlock Classes="hint" Text="Gli inviti vengono spediti da Google Calendar quando l'evento è in un calendario Google." />
                    </StackPanel>

                    <TextBlock Classes="section" Text="Autorizzazioni per gli invitati" Margin="0,10,0,0" />
                    <CheckBox Content="Modificare l'evento" IsChecked="{Binding GuestsCanModify}" />
                    <CheckBox Content="Invitare altre persone" IsChecked="{Binding GuestsCanInvite}" />
                    <CheckBox Content="Vedere l'elenco invitati" IsChecked="{Binding GuestsCanSeeList}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

