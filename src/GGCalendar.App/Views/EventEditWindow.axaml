<Window xmlns:loc="using:GGCalendar.App.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        x:Class="GGCalendar.App.Views.EventEditWindow"
        x:DataType="vm:EventEditViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="1080" Height="780" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterOwner"
        Title="{Binding Header}">

    <Window.Styles>
        <Style Selector="TextBlock.section">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>
        <Style Selector="TextBlock.icon">
            <Setter Property="Width" Value="28" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style Selector="TextBlock.hint">
            <Setter Property="Opacity" Value="0.6" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style Selector="Button.link">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="#1A73E8" />
        </Style>
        <Style Selector="Button.iconbtn">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.iconbtn > TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="18" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="24,16,24,16">
        <!-- Header: title, save, cancel, delete, export -->
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto,Auto,Auto,Auto" Margin="0,0,0,12">
            <TextBox Name="TitleBox" Text="{Binding Title}" PlaceholderText="{loc:T edit.add_title}" FontSize="22" Margin="0,0,16,0" />
            <Button AutomationProperties.AutomationId="Edit.Save" Grid.Column="1" Content="{loc:T common.save}" Classes="accent" CornerRadius="18" Padding="26,8" IsDefault="True" Click="OnSave"
                    ToolTip.Tip="{loc:T edit.save_tip}" />
            <Button AutomationProperties.AutomationId="Edit.Cancel" Grid.Column="2" Content="{loc:T common.cancel}" CornerRadius="18" Padding="22,8" Margin="8,0,8,0" IsCancel="True" Click="OnCancel"
                    ToolTip.Tip="{loc:T edit.cancel_tip}" />
            <Button AutomationProperties.AutomationId="Edit.Delete" Grid.Column="3" Classes="iconbtn" Click="OnDelete" IsVisible="{Binding !IsNew}" ToolTip.Tip="{loc:T edit.delete_event}">
                <TextBlock Text="&#xE74D;" />
            </Button>
            <Button AutomationProperties.AutomationId="Edit.Export" Grid.Column="4" Classes="iconbtn" Click="OnExport" ToolTip.Tip="{loc:T edit.export_ics}">
                <TextBlock Text="&#xE896;" />
            </Button>
        </Grid>

        <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Foreground="#D93025" Margin="0,8,0,0"
                   IsVisible="{Binding Error, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

        <!-- Date / time -->
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="0,0,0,14">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <CalendarDatePicker SelectedDate="{Binding StartDate}" FirstDayOfWeek="Monday" />
                <TimePicker SelectedTime="{Binding StartTime}" IsVisible="{Binding IsTimed}" MinuteIncrement="5"
                            ClockIdentifier="{Binding Use24Hour, Converter={x:Static vm:ClockConverter.Instance}}" />
                <TextBlock Text="–" VerticalAlignment="Center" />
                <TimePicker SelectedTime="{Binding EndTime}" IsVisible="{Binding IsTimed}" MinuteIncrement="5"
                            ClockIdentifier="{Binding Use24Hour, Converter={x:Static vm:ClockConverter.Instance}}" />
                <CalendarDatePicker SelectedDate="{Binding EndDate}" FirstDayOfWeek="Monday" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="16">
                <CheckBox Content="{loc:T edit.all_day}" IsChecked="{Binding IsAllDay}" />
                <ComboBox ItemsSource="{Binding RecurrenceOptions}" SelectedItem="{Binding Recurrence}" MinWidth="240" DisplayMemberBinding="{ReflectionBinding Label}" />
                <TextBlock Text="{Binding TimeZoneText}" Classes="hint" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <Grid ColumnDefinitions="*,24,320">
            <!-- Details -->
            <ScrollViewer>
                <StackPanel Spacing="14" Margin="0,0,12,0">
                    <!-- Meet -->
                    <StackPanel Orientation="Horizontal" Spacing="0">
                        <TextBlock Classes="icon" Text="📹" />
                        <CheckBox IsChecked="{Binding AddMeet}" Content="{loc:T edit.add_meet}" />
                    </StackPanel>
                    <StackPanel Margin="28,-8,0,0" IsVisible="{Binding AddMeet}" Spacing="4">
                        <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding HasMeetLink}">
                            <HyperlinkButton Content="{Binding MeetLink}" Click="OnOpenMeet" Padding="0" VerticalAlignment="Center"
                                             ToolTip.Tip="{loc:T edit.join_meet}" />
                            <Button Content="{loc:T common.copy}" Click="OnCopyMeet" />
                        </StackPanel>
                        <TextBlock Classes="hint" IsVisible="{Binding !HasMeetLink}"
                                   Text="{loc:T edit.meet_note}" />
                    </StackPanel>

                    <!-- Location -->
                    <!-- Icon rows are Grids, not horizontal StackPanels: those give their content unlimited width,
                         so long hints never wrap and fixed-width boxes get cut off in a narrow window. -->
                    <Grid ColumnDefinitions="28,*">
                        <TextBlock Classes="icon" Text="📍" />
                        <TextBox Grid.Column="1" Text="{Binding Location}" PlaceholderText="{loc:T edit.add_location}" MaxWidth="480" HorizontalAlignment="Stretch" />
                    </Grid>

                    <!-- Reminders -->
                    <Grid ColumnDefinitions="28,*">
                        <TextBlock Classes="icon" Text="🔔" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <ItemsControl ItemsSource="{Binding Reminders}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:ReminderItemViewModel">
                                        <WrapPanel Margin="0,0,0,8" ItemSpacing="8" LineSpacing="6" MaxWidth="520">
                                            <ComboBox ItemsSource="{x:Static vm:ReminderItemViewModel.Methods}" SelectedItem="{Binding Method}" Width="120">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReminderMethodOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <NumericUpDown Value="{Binding Value}" Minimum="0" Maximum="9999" FormatString="0" Width="110" />
                                            <ComboBox ItemsSource="{x:Static vm:ReminderItemViewModel.Units}" SelectedItem="{Binding Unit}" Width="120">
                                                <ComboBox.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:ReminderUnitOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                </ComboBox.ItemTemplate>
                                            </ComboBox>
                                            <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding IsPopup}">
                                                <ComboBox ItemsSource="{Binding SoundOptions}" SelectedItem="{Binding Sound}" Width="230">
                                                    <ComboBox.ItemTemplate>
                                                        <DataTemplate x:DataType="vm:SoundOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                                                    </ComboBox.ItemTemplate>
                                                </ComboBox>
                                                <Button Content="▶" Click="OnPreviewSound" ToolTip.Tip="{loc:T common.listen}" />
                                                <Button Content="📂" Click="OnBrowseSound" ToolTip.Tip="{loc:T common.choose_audio}" />
                                            </StackPanel>
                                            <Button Content="✕" Background="Transparent" Click="OnRemoveReminder" ToolTip.Tip="{loc:T common.remove}" />
                                        </WrapPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="{loc:T edit.add_notification}" Classes="link" Command="{Binding AddReminderCommand}" IsEnabled="{Binding CanAddReminder}" Padding="0" />
                            <TextBlock Classes="hint" MaxWidth="640" HorizontalAlignment="Left"
                                       Text="{loc:T edit.notifications_note}" />
                        </StackPanel>
                    </Grid>

                    <!-- Calendar + color -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="📅" />
                        <ComboBox ItemsSource="{Binding Calendars}" SelectedItem="{Binding SelectedCalendar}" MinWidth="260">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Name}" />
                                        <TextBlock Text="{Binding AccountName}" Opacity="0.6" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <ComboBox ItemsSource="{Binding ColorOptions}" SelectedItem="{Binding EventColor}" MinWidth="200">
                            <ComboBox.ItemTemplate>
                                <DataTemplate x:DataType="vm:ColorOption">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <Ellipse Width="12" Height="12" Fill="{Binding Hex, TargetNullValue=#888888}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Label}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>

                    <!-- Availability / visibility -->
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Classes="icon" Text="💼" />
                        <ComboBox ItemsSource="{Binding AvailabilityOptions}" SelectedItem="{Binding Availability}" MinWidth="140" DisplayMemberBinding="{ReflectionBinding Label}" />
                        <ComboBox ItemsSource="{Binding VisibilityOptions}" SelectedItem="{Binding Visibility}" MinWidth="200" DisplayMemberBinding="{ReflectionBinding Label}" />
                    </StackPanel>

                    <!-- Description -->
                    <Grid ColumnDefinitions="28,*">
                        <TextBlock Classes="icon" Text="≡" VerticalAlignment="Top" Margin="0,6,0,0" />
                        <TextBox Grid.Column="1" Text="{Binding Description}" PlaceholderText="{loc:T edit.add_description}" AcceptsReturn="True" TextWrapping="Wrap"
                                 MaxWidth="640" HorizontalAlignment="Stretch" MinHeight="150" />
                    </Grid>
                </StackPanel>
            </ScrollViewer>

            <Rectangle Grid.Column="1" Width="1" Fill="#33888888" HorizontalAlignment="Center" />

            <!-- Guests -->
            <ScrollViewer Grid.Column="2">
                <StackPanel Spacing="12">
                    <TextBlock Classes="section" Text="{loc:T edit.guests}" FontSize="15" />
                    <Grid ColumnDefinitions="*,Auto">
                        <TextBox Text="{Binding NewAttendee}" PlaceholderText="{loc:T edit.add_guests}" KeyDown="OnAttendeeKeyDown" />
                        <Button Grid.Column="1" Content="＋" Margin="6,0,0,0" Command="{Binding AddAttendeeCommand}" />
                    </Grid>
                    <ItemsControl ItemsSource="{Binding Attendees}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AttendeeViewModel">
                                <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2">
                                    <TextBlock Text="{Binding Email}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                    <CheckBox Grid.Column="1" Content="{loc:T edit.optional}" IsChecked="{Binding IsOptional}" FontSize="12" />
                                    <Button Grid.Column="2" Content="✕" Background="Transparent" Click="OnRemoveAttendee" />
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <StackPanel Spacing="4" IsVisible="{Binding HasAttendees}">
                        <CheckBox Content="{loc:T edit.send_invites}" IsChecked="{Binding SendInvites}" />
                        <TextBlock Classes="hint" Text="{loc:T edit.invites_note}" />
                    </StackPanel>

                    <TextBlock Classes="section" Text="{loc:T edit.guest_permissions}" Margin="0,10,0,0" />
                    <CheckBox Content="{loc:T guests.modify}" IsChecked="{Binding GuestsCanModify}" />
                    <CheckBox Content="{loc:T guests.invite}" IsChecked="{Binding GuestsCanInvite}" />
                    <CheckBox Content="{loc:T guests.see_list}" IsChecked="{Binding GuestsCanSeeList}" />
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>

