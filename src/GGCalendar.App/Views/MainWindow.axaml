<Window xmlns:loc="using:GGCalendar.App.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        xmlns:ctl="using:GGCalendar.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="760"
        x:Class="GGCalendar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="1300" Height="780" MinWidth="900" MinHeight="500"
        Title="GGCalendar">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.calitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14888888" />
        </Style>
        <Style Selector="Button.calitem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22888888" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="SelectableTextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="SelectableTextBlock.error">
            <Setter Property="Foreground" Value="#D93025" />
        </Style>
        <Style Selector="Border.drop">
            <Setter Property="Background" Value="#331A73E8" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="#33808080"
                IsVisible="{Binding SyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <SelectableTextBlock Text="{Binding SyncStatus}" FontSize="12" TextWrapping="Wrap" MaxHeight="72"
                                 Classes.error="{Binding SyncIsError}" Classes.muted="{Binding !SyncIsError}" />
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="Auto,*,Auto" Margin="16,10">
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <TextBlock Text="GGCalendar" FontSize="20" FontWeight="SemiBold" Margin="0,0,24,0" VerticalAlignment="Center" />
                <Button AutomationProperties.AutomationId="Main.Today" Content="{loc:T main.today}" Command="{Binding TodayCommand}" CornerRadius="18" Padding="16,6" />
                <Button Classes="nav" Content="‹" FontSize="20" Command="{Binding PreviousCommand}" />
                <Button Classes="nav" Content="›" FontSize="20" Command="{Binding NextCommand}" />
                <TextBlock Text="{Binding Title}" FontSize="22" Margin="8,0,0,0" VerticalAlignment="Center" />
                <Border CornerRadius="4" Padding="6,2" Background="#22888888" VerticalAlignment="Center" Margin="6,0,0,0" IsVisible="{Binding Settings.ShowWeekNumbers}">
                    <TextBlock FontSize="12" Text="{Binding WeekLabel}" />
                </Border>
            </StackPanel>
            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
                <Button AutomationProperties.AutomationId="Main.SyncNow" Classes="nav" Padding="0" Click="OnSyncNow" IsEnabled="{Binding !IsSyncing}" ToolTip.Tip="{loc:T main.sync_now}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button CornerRadius="18" Padding="18,6" MinWidth="140">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ViewModeName}" VerticalAlignment="Center" />
                        <TextBlock Text="&#x25BE;" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{loc:T main.view_day}" InputGesture="D" Tag="0" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_week}" InputGesture="W" Tag="1" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_month}" InputGesture="M" Tag="2" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_year}" InputGesture="Y" Tag="3" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_agenda}" InputGesture="A" Tag="4" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_6days}" InputGesture="X" Tag="5" Click="OnViewModeSelected" />
                            <Separator />
                            <MenuItem Header="{loc:T main.show_weekends}" ToggleType="CheckBox" IsChecked="{Binding ShowWeekends, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.AutomationId="Main.Settings" Classes="nav" Padding="0" Click="OnOpenSettings" ToolTip.Tip="{loc:T main.settings}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Classes="nav" Padding="0" Click="OnOpenAbout" ToolTip.Tip="{loc:T main.about}">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <Border DockPanel.Dock="Left" Width="260" Padding="12,0">
            <DockPanel>
                <!-- A single button: it opens the menu where the thing to create is chosen. -->
                <Button AutomationProperties.AutomationId="Main.Create" Name="CreateButton" DockPanel.Dock="Top" Content="{loc:T main.create}" Padding="16,6" CornerRadius="18" Margin="0,4,0,16">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem AutomationProperties.AutomationId="Menu.CreateEvent" Name="CreateEventItem" Header="{loc:T main.create_event}" Click="OnNewEvent" />
                            <MenuItem AutomationProperties.AutomationId="Menu.CreateLocalCalendar" Name="CreateLocalCalendarItem" Header="{loc:T main.create_local_calendar}" Click="OnNewLocalCalendar" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Viewbox DockPanel.Dock="Top" Height="250" StretchDirection="DownOnly">
                    <Calendar Name="MiniCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" FirstDayOfWeek="{Binding Settings.FirstDayOfWeek}" Width="300" />
                </Viewbox>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8" Spacing="2">
                    <TextBlock Classes="muted" FontSize="11" Margin="8,2,0,0" Text="{loc:T main.calendars_hint}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Margin="0,16,0,0">
                    <!-- Right margin: the scroll bar grows over the list when the pointer is on it and must not cover the arrows. -->
                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountGroup">
                                <StackPanel Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,6" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem Header="{loc:T main.new_calendar_todo}" Click="OnNewCalendarInAccount" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#A8C7FA" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" Foreground="#0B2A52" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="nav" Width="28" Height="28" Padding="0" VerticalAlignment="Center" Click="OnToggleAccount"
                                                ToolTip.Tip="{loc:T main.toggle_account}">
                                            <TextBlock Text="{Binding Chevron}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Calendars}" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                                <Border Classes.drop="{Binding IsDropTarget}" CornerRadius="6" Padding="0,2">
                                                    <Border.ContextMenu>
                                                        <!-- No ResizeY: near the bottom of the screen the menu must open upwards or slide, not shrink and scroll. -->
                                                        <ContextMenu PlacementConstraintAdjustment="FlipX,FlipY,SlideX,SlideY">
                                                            <MenuItem Header="{loc:T main.import_here}" Click="OnImportIntoCalendar" />
                                                            <MenuItem Header="{loc:T main.export_calendar}" Click="OnExportCalendar" />
                                                            <Separator IsVisible="{Binding IsLocal}" />
                                                            <MenuItem Header="{loc:T main.delete_calendar}" Click="OnDeleteCalendar" IsVisible="{Binding IsLocal}" />
                                                            <!-- TODO: delete a Google calendar (not built yet). -->
                                                            <MenuItem Header="{loc:T main.delete_google_calendar_todo}" IsVisible="{Binding IsGoogle}" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <!-- Round avatar for the account, rounded squares for the calendars: filled with the calendar colour and a tick when shown, an outline when hidden. -->
                                                    <!-- A button (not a plain panel) so that the keyboard and the tests can use it too. -->
                                                    <Button Classes="calitem" AutomationProperties.AutomationId="Calendar.Toggle" Margin="4,1" Click="OnCalendarToggled">
                                                      <Grid ColumnDefinitions="Auto,*" Margin="0,2">
                                                        <Border Width="20" Height="20" CornerRadius="4" BorderThickness="2" BorderBrush="{Binding ColorHex}" VerticalAlignment="Center">
                                                            <Border Background="{Binding ColorHex}" CornerRadius="1" Margin="-2" IsVisible="{Binding IsVisible}">
                                                                <TextBlock Text="&#x2713;" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                      </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Panel>
        <ctl:MonthGrid Name="Month" DimPast="{Binding Settings.DimPastEvents}" IsVisible="{Binding IsMonth}" Margin="0,0,12,0" ShowWeekends="{Binding ShowWeekends}"
                       GridStart="{Binding MonthGridStart}" Month="{Binding MonthNumber}"
                       Events="{Binding VisibleEvents}" CalendarColors="{Binding CalendarColors}" />

        <ScrollViewer IsVisible="{Binding IsYear}">
            <ctl:YearGrid Name="Year" Year="{Binding YearNumber}" FirstDayOfWeek="{Binding Settings.FirstDayOfWeek}"
                          Events="{Binding VisibleEvents}" Margin="12,0" />
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsAgenda}">
            <ItemsControl ItemsSource="{Binding AgendaDays}" Margin="24,8,24,24" MaxWidth="900">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgendaDay">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgendaItem">
                                        <Border Background="Transparent" Padding="8,6" Cursor="Hand" Tapped="OnAgendaItemTapped" DoubleTapped="OnAgendaItemOpened">
                                            <Grid ColumnDefinitions="18,170,*">
                                                <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="{Binding Time}" Classes="muted" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock IsVisible="{Binding ShowAgendaEmpty}" Text="{loc:T main.agenda_empty}" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Name="AgendaEmpty" />

        <DockPanel IsVisible="{Binding IsTimeGrid}">
            <Panel DockPanel.Dock="Top"><TextBlock Text="{Binding TimeZoneLabel}" Classes="muted" FontSize="11" Margin="8,0,0,6" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding Days}" Margin="56,4,12,4">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayHeader">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Classes="muted" />
                            <Border Width="40" Height="40" CornerRadius="20" Classes.today="{Binding IsToday}">
                                <Border.Styles>
                                    <Style Selector="Border.today">
                                        <Setter Property="Background" Value="#1A73E8" />
                                    </Style>
                                    <Style Selector="Border.today TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </Border.Styles>
                                <TextBlock Text="{Binding Number}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Panel>
            <ctl:AllDayStrip Name="AllDay" DimPast="{Binding Settings.DimPastEvents}" DockPanel.Dock="Top" Margin="0,0,12,0"
                             WeekStart="{Binding WeekStart}" DayCount="{Binding DayCount}"
                             Events="{Binding VisibleEvents}"
                             CalendarColors="{Binding CalendarColors}" />
            <ScrollViewer Name="GridScroll">
                <!-- Same 12px right margin as the day headers and the all-day strip, so the columns line up:
                     the Fluent scrollbar overlays the content instead of taking space, and sits in that margin. -->
                <ctl:WeekGrid Name="Grid" Margin="0,0,12,0" DimPast="{Binding Settings.DimPastEvents}"
                              WeekStart="{Binding WeekStart}" DayCount="{Binding DayCount}"
                              Events="{Binding VisibleEvents}"
                              CalendarColors="{Binding CalendarColors}"
                              FirstHour="{Binding FirstHour}"
                              LastHour="{Binding LastHour}"
                              Use24Hour="{Binding Settings.Use24HourClock}"
                              SnapMinutes="{Binding Settings.SnapMinutes}"
                              DefaultMinutes="{Binding Settings.DefaultEventMinutes}" />
            </ScrollViewer>
        </DockPanel>

        <!-- Event details shown on a single click, beside the clicked event (content set in code). A click outside closes it
             and still reaches the calendar, so clicking another event opens that one directly. -->
        <Popup Name="DetailsPopup" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
               Placement="RightEdgeAlignedTop" HorizontalOffset="8" PlacementConstraintAdjustment="FlipX,FlipY,SlideX,SlideY" />
        </Panel>
    </DockPanel>
</Window>
