<Window xmlns:loc="using:GGCalendar.App.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        xmlns:ctl="using:GGCalendar.App.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="1300" d:DesignHeight="760"
        x:Class="GGCalendar.App.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="1300" Height="780" MinWidth="900" MinHeight="500"
        Title="GGCalendar">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <!-- A solid background for what covers the view (the results) or floats over it (the detailed panel of the search). -->
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="SearchSurfaceBrush">#FFFFFF</SolidColorBrush>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="SearchSurfaceBrush">#202020</SolidColorBrush>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Button.nav">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style Selector="Button.calitem">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <Style Selector="Button.calitem:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#14888888" />
        </Style>
        <Style Selector="Button.calitem:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#22888888" />
        </Style>
        <Style Selector="Border.searchrow:pointerover">
            <Setter Property="Background" Value="#14888888" />
        </Style>
        <Style Selector="TextBlock.muted">
            <Setter Property="Opacity" Value="0.65" />
        </Style>
        <Style Selector="SelectableTextBlock.muted">
            <Setter Property="Opacity" Value="0.7" />
        </Style>
        <Style Selector="SelectableTextBlock.error">
            <Setter Property="Foreground" Value="#D93025" />
        </Style>
        <Style Selector="Border.drop">
            <Setter Property="Background" Value="#331A73E8" />
        </Style>
    </Window.Styles>

    <DockPanel>
        <Border DockPanel.Dock="Bottom" Padding="16,4" BorderThickness="0,1,0,0" BorderBrush="#33808080"
                IsVisible="{Binding SyncStatus, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <SelectableTextBlock Text="{Binding SyncStatus}" FontSize="12" TextWrapping="Wrap" MaxHeight="72"
                                 Classes.error="{Binding SyncIsError}" Classes.muted="{Binding !SyncIsError}" />
        </Border>
        <Grid DockPanel.Dock="Top" ColumnDefinitions="*,Auto" Margin="16,10">
            <!-- The title of the view is the one that gives way when the window is narrow: it is cut with dots, the buttons on the right stay. -->
            <Grid ColumnDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnSpacing="8" VerticalAlignment="Center" HorizontalAlignment="Left" ClipToBounds="True">
                <TextBlock Text="GGCalendar" FontSize="20" FontWeight="SemiBold" Margin="0,0,16,0" VerticalAlignment="Center" />
                <Button Grid.Column="1" AutomationProperties.AutomationId="Main.Today" Content="{loc:T main.today}" Command="{Binding TodayCommand}" CornerRadius="18" Padding="16,6" />
                <Button Grid.Column="2" Classes="nav" Content="‹" FontSize="20" Command="{Binding PreviousCommand}" />
                <Button Grid.Column="3" Classes="nav" Content="›" FontSize="20" Command="{Binding NextCommand}" />
                <TextBlock Grid.Column="4" Text="{Binding Title}" FontSize="22" Margin="8,0,0,0" MaxWidth="320" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <Border Grid.Column="5" CornerRadius="4" Padding="6,2" Background="#22888888" VerticalAlignment="Center" IsVisible="{Binding Settings.ShowWeekNumbers}">
                    <TextBlock FontSize="12" Text="{Binding WeekLabel}" />
                </Border>
            </Grid>
            <StackPanel Grid.Column="1" Margin="12,0,0,0" Orientation="Horizontal" Spacing="8">
                <!-- Search (issue #8): the box appears here when the lens is pressed; the arrow opens the detailed panel as a popup over the rest of the window. -->
        <Border Name="SearchBar" IsVisible="{Binding Search.IsOpen}" Width="440" Padding="12,2" CornerRadius="20" VerticalAlignment="Center" Background="{DynamicResource SearchSurfaceBrush}"
                BorderThickness="1" BorderBrush="#33808080">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="8">
                <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16" VerticalAlignment="Center" Margin="4,0" />
                <TextBox Grid.Column="1" Name="SearchBox" AutomationProperties.AutomationId="Search.Box" Text="{Binding Search.Text}"
                         Watermark="{loc:T search.box_hint}" ToolTip.Tip="{loc:T search.syntax_tip}" BorderThickness="0" Background="Transparent" KeyDown="OnSearchBoxKeyDown" />
                <TextBlock Grid.Column="2" Text="{Binding Search.Summary}" Classes="muted" VerticalAlignment="Center" AutomationProperties.AutomationId="Search.Summary" />
                <Button Grid.Column="3" Classes="nav" Padding="0" Click="OnToggleAdvancedSearch" AutomationProperties.AutomationId="Search.Advanced" ToolTip.Tip="{loc:T search.advanced_tip}">
                    <TextBlock Text="&#xE70D;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Grid.Column="4" Classes="nav" Padding="0" Click="OnCloseSearch" AutomationProperties.AutomationId="Search.Close" ToolTip.Tip="{loc:T search.close_tip}">
                    <TextBlock Text="&#xE711;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Popup Name="SearchPanel" IsOpen="{Binding Search.IsAdvanced}" PlacementTarget="{Binding #SearchBar}" Placement="BottomEdgeAlignedRight" IsLightDismissEnabled="False"
                       Width="760" VerticalOffset="6">
                    <Border Background="{DynamicResource SearchSurfaceBrush}" BorderThickness="1" BorderBrush="#33808080" CornerRadius="24"
                            Padding="24,20,24,16" BoxShadow="0 8 28 0 #50000000">
                        <Grid ColumnDefinitions="140,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="8"
                              KeyDown="OnSearchFieldKeyDown" MaxWidth="760" HorizontalAlignment="Left">
                            <TextBlock Text="{loc:T search.scope_label}" VerticalAlignment="Center" />
                            <Button Grid.Column="1" Name="SearchScopeButton" AutomationProperties.AutomationId="Search.Scope" HorizontalAlignment="Left" MinWidth="240" Padding="12,6">
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBlock Text="{Binding Search.ScopeLabel}" VerticalAlignment="Center" MaxWidth="260" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Grid.Column="1" Text="&#x25BE;" Margin="12,0,0,0" Opacity="0.7" VerticalAlignment="Center" />
                                </Grid>
                                <Button.Flyout>
                                    <Flyout Placement="BottomEdgeAlignedLeft">
                                        <StackPanel Width="300" Spacing="2">
                                            <Button Classes="calitem" Padding="8,6" Tag="0" Click="OnSearchScope" AutomationProperties.AutomationId="Search.ScopeActive">
                                                <Grid ColumnDefinitions="24,*"><TextBlock Text="&#x2713;" IsVisible="{Binding Search.ActiveTick}" /><TextBlock Grid.Column="1" Text="{loc:T search.scope_active}" /></Grid>
                                            </Button>
                                            <Button Classes="calitem" Padding="8,6" Tag="1" Click="OnSearchScope" AutomationProperties.AutomationId="Search.ScopeAll">
                                                <Grid ColumnDefinitions="24,*"><TextBlock Text="&#x2713;" IsVisible="{Binding Search.AllTick}" /><TextBlock Grid.Column="1" Text="{loc:T search.scope_all}" /></Grid>
                                            </Button>
                                            <Separator Margin="0,4" />
                                            <!-- Many calendars: the list scrolls and "Fatto" stays in view below it. -->
                                            <ScrollViewer MaxHeight="300" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="Search.CalendarList">
                                            <ItemsControl ItemsSource="{Binding Search.Calendars}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SearchCalendarOption">
                                                        <CheckBox IsChecked="{Binding IsSelected}" Margin="8,0" AutomationProperties.AutomationId="Search.CalendarOption">
                                                            <StackPanel Orientation="Horizontal" Spacing="8">
                                                                <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" VerticalAlignment="Center" />
                                                                <!-- A long name is cut with dots, so the list never gets wider than the popup. -->
                                                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" MaxWidth="200" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                            </ScrollViewer>
                                            <Separator Margin="0,4" />
                                            <Button Content="{loc:T search.done}" Classes="accent" HorizontalAlignment="Right" Margin="0,2,8,4" Click="OnSearchScopeDone" AutomationProperties.AutomationId="Search.ScopeDone" />
                                        </StackPanel>
                                    </Flyout>
                                </Button.Flyout>
                            </Button>
                            <TextBlock Grid.Row="1" Text="{loc:T search.what}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Search.WhatText}" Watermark="{loc:T search.what_hint}" AutomationProperties.AutomationId="Search.What" />
                            <TextBlock Grid.Row="2" Text="{loc:T search.who}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Search.WhoText}" Watermark="{loc:T search.who_hint}" AutomationProperties.AutomationId="Search.Who" />
                            <TextBlock Grid.Row="3" Text="{loc:T search.where}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Search.WhereText}" Watermark="{loc:T search.where_hint}" AutomationProperties.AutomationId="Search.Where" />
                            <TextBlock Grid.Row="4" Text="{loc:T search.not}" VerticalAlignment="Center" />
                            <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Search.NotText}" Watermark="{loc:T search.not_hint}" AutomationProperties.AutomationId="Search.Not" />
                            <TextBlock Grid.Row="5" Text="{loc:T search.date}" VerticalAlignment="Center" />
                            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="8">
                                <CalendarDatePicker SelectedDate="{Binding Search.FromDate}" Watermark="{loc:T search.from_hint}" AutomationProperties.AutomationId="Search.From" />
                                <TextBlock Text="&#x2013;" VerticalAlignment="Center" />
                                <CalendarDatePicker SelectedDate="{Binding Search.ToDate}" Watermark="{loc:T search.to_hint}" AutomationProperties.AutomationId="Search.To" />
                            </StackPanel>
                            <StackPanel Grid.Row="6" Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right" Margin="0,4,0,0">
                                <Button Content="{loc:T common.cancel}" Click="OnCancelAdvancedSearch" AutomationProperties.AutomationId="Search.CancelAdvanced" />
                                <Button Content="{loc:T search.run}" Classes="accent" Click="OnRunSearch" AutomationProperties.AutomationId="Search.Run" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Popup>
            </Grid>
        </Border>
                <Button AutomationProperties.AutomationId="Main.Search" Classes="nav" Padding="0" Click="OnToggleSearch" ToolTip.Tip="{loc:T search.tip}">
                    <TextBlock Text="&#xE721;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button AutomationProperties.AutomationId="Main.SyncNow" Classes="nav" Padding="0" Click="OnSyncNow" IsEnabled="{Binding !IsSyncing}" ToolTip.Tip="{loc:T main.sync_now}">
                    <TextBlock Text="&#xE72C;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button AutomationProperties.AutomationId="Main.ViewMode" CornerRadius="18" Padding="18,6">
                    <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Center">
                        <TextBlock Text="{Binding ViewModeName}" VerticalAlignment="Center" MinWidth="90" />
                        <TextBlock Text="&#x25BE;" VerticalAlignment="Center" Opacity="0.7" />
                    </StackPanel>
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuItem Header="{loc:T main.view_day}" InputGesture="D" Tag="0" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_week}" InputGesture="W" Tag="1" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_month}" InputGesture="M" Tag="2" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_year}" InputGesture="Y" Tag="3" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_agenda}" InputGesture="A" Tag="4" Click="OnViewModeSelected" />
                            <MenuItem Header="{loc:T main.view_6days}" InputGesture="X" Tag="5" Click="OnViewModeSelected" />
                            <Separator />
                            <MenuItem Header="{loc:T main.show_weekends}" ToggleType="CheckBox" IsChecked="{Binding ShowWeekends, Mode=TwoWay}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Button AutomationProperties.AutomationId="Main.Settings" Classes="nav" Padding="0" Click="OnOpenSettings" ToolTip.Tip="{loc:T main.settings}">
                    <TextBlock Text="&#xE713;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="18"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
                <Button Classes="nav" Padding="0" Click="OnOpenAbout" ToolTip.Tip="{loc:T main.about}">
                    <TextBlock Text="&#xE946;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="16"
                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Button>
            </StackPanel>
        </Grid>

        <!-- The list of the accounts and calendars is wide enough for most names; a longer one is cut with dots and the tooltip shows it whole. -->
        <Border DockPanel.Dock="Left" Width="340" Padding="12,0">
            <DockPanel>
                <!-- A single button: it opens the menu where the thing to create is chosen. -->
                <Button AutomationProperties.AutomationId="Main.Create" Name="CreateButton" DockPanel.Dock="Top" Content="{loc:T main.create}" Padding="16,6" CornerRadius="18" Margin="0,4,0,16">
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedLeft">
                            <MenuItem AutomationProperties.AutomationId="Menu.CreateEvent" Name="CreateEventItem" Header="{loc:T main.create_event}" Click="OnNewEvent" />
                            <MenuItem AutomationProperties.AutomationId="Menu.CreateLocalCalendar" Name="CreateLocalCalendarItem" Header="{loc:T main.create_local_calendar}" Click="OnNewLocalCalendar" />
                            <MenuItem AutomationProperties.AutomationId="Menu.CreateGoogleCalendar" Name="CreateGoogleCalendarItem" Header="{loc:T main.create_google_calendar}" Click="OnNewGoogleCalendar" IsEnabled="{Binding HasGoogleAccounts}" />
                            <MenuItem AutomationProperties.AutomationId="Menu.CreatePublicCalendar" Name="CreatePublicCalendarItem" Header="{loc:T main.create_public_calendar}" Click="OnNewPublicCalendar" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
                <Viewbox DockPanel.Dock="Top" Height="250" StretchDirection="DownOnly">
                    <Calendar Name="MiniCalendar" SelectedDate="{Binding SelectedDate, Mode=TwoWay}" FirstDayOfWeek="{Binding Settings.FirstDayOfWeek}" Width="300" />
                </Viewbox>
                <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,8" Spacing="2">
                    <TextBlock Classes="muted" FontSize="11" Margin="8,2,0,0" Text="{loc:T main.calendars_hint}" TextWrapping="Wrap" />
                </StackPanel>
                <ScrollViewer Margin="0,16,0,0">
                    <!-- Right margin: the scroll bar grows over the list when the pointer is on it and must not cover the arrows. -->
                    <ItemsControl ItemsSource="{Binding Accounts}" Margin="0,0,20,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:AccountGroup">
                                <StackPanel Margin="0,0,0,12">
                                    <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,4,0,6" Background="Transparent">
                                        <Grid.ContextMenu>
                                            <ContextMenu>
                                                <MenuItem AutomationProperties.AutomationId="Menu.NewCalendarInAccount" Header="{loc:T menu.new_calendar_here}" Click="OnNewCalendarInAccount" IsVisible="{Binding !IsSubscriptions}" />
                                                <MenuItem AutomationProperties.AutomationId="Menu.AddPublicCalendar" Header="{loc:T main.create_public_calendar}" Click="OnNewPublicCalendar" IsVisible="{Binding IsSubscriptions}" />
                                            </ContextMenu>
                                        </Grid.ContextMenu>
                                        <Border Width="32" Height="32" CornerRadius="16" Background="#A8C7FA" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding Initial}" Foreground="#0B2A52" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Border>
                                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DisplayName}" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding DisplayName}" />
                                            <TextBlock Text="{Binding Kind}" Classes="muted" FontSize="11" />
                                        </StackPanel>
                                        <Button Grid.Column="2" Classes="nav" Width="28" Height="28" Padding="0" VerticalAlignment="Center" Click="OnToggleAccount"
                                                ToolTip.Tip="{loc:T main.toggle_account}">
                                            <TextBlock Text="{Binding Chevron}" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="12" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                        </Button>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Calendars}" IsVisible="{Binding IsExpanded}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:CalendarItemViewModel">
                                                <Border Classes.drop="{Binding IsDropTarget}" CornerRadius="6" Padding="0,2">
                                                    <Border.ContextMenu>
                                                        <!-- No ResizeY: near the bottom of the screen the menu must open upwards or slide, not shrink and scroll. -->
                                                        <ContextMenu PlacementConstraintAdjustment="FlipX,FlipY,SlideX,SlideY">
                                                            <MenuItem AutomationProperties.AutomationId="Menu.EditCalendar" Header="{loc:T main.edit_calendar}" Click="OnEditCalendar" IsVisible="{Binding !IsSubscription}" />
                                                            <Separator IsVisible="{Binding !IsSubscription}" />
                                                            <MenuItem Header="{loc:T main.import_here}" Click="OnImportIntoCalendar" IsVisible="{Binding !IsSubscription}" />
                                                            <MenuItem Header="{loc:T main.export_calendar}" Click="OnExportCalendar" IsVisible="{Binding !IsSubscription}" />
                                                            <MenuItem AutomationProperties.AutomationId="Menu.SubRefresh" Header="{loc:T sub.refresh_now}" Click="OnRefreshSubscription" IsVisible="{Binding IsSubscription}" />
                                                            <MenuItem AutomationProperties.AutomationId="Menu.SubEdit" Header="{loc:T main.edit_calendar}" Click="OnEditSubscription" IsVisible="{Binding IsSubscription}" />
                                                            <MenuItem AutomationProperties.AutomationId="Menu.SubShowUrl" Header="{loc:T sub.show_url}" Click="OnShowSubscriptionUrl" IsVisible="{Binding IsSubscription}" />
                                                            <Separator IsVisible="{Binding IsSubscription}" />
                                                            <MenuItem AutomationProperties.AutomationId="Menu.SubRemove" Header="{loc:T sub.remove}" Click="OnRemoveSubscription" IsVisible="{Binding IsSubscription}" />
                                                            <Separator IsVisible="{Binding !IsSubscription}" />
                                                            <MenuItem Header="{loc:T main.delete_calendar}" Click="OnDeleteCalendar" IsVisible="{Binding IsLocal}" />
                                                            <!-- A calendar of Google: grey (with the reason as a tooltip) when it cannot be deleted: the primary one, one the person does not own. -->
                                                            <MenuItem AutomationProperties.AutomationId="Menu.DeleteGoogleCalendar" Header="{loc:T main.delete_calendar}" Click="OnDeleteGoogleCalendar"
                                                                      IsVisible="{Binding IsGoogle}" IsEnabled="{Binding CanDeleteFromGoogle}" ToolTip.Tip="{Binding DeleteHint}" ToolTip.ShowOnDisabled="True" />
                                                        </ContextMenu>
                                                    </Border.ContextMenu>
                                                    <!-- Round avatar for the account, rounded squares for the calendars: filled with the calendar colour and a tick when shown, an outline when hidden. -->
                                                    <!-- A button (not a plain panel) so that the keyboard and the tests can use it too. -->
                                                    <Button Classes="calitem" AutomationProperties.AutomationId="Calendar.Toggle" Margin="4,1" Click="OnCalendarToggled">
                                                      <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,2">
                                                        <Border Width="20" Height="20" CornerRadius="4" BorderThickness="2" BorderBrush="{Binding ColorHex}" VerticalAlignment="Center">
                                                            <Border Background="{Binding ColorHex}" CornerRadius="1" Margin="-2" IsVisible="{Binding IsVisible}">
                                                                <TextBlock Text="&#x2713;" Foreground="White" FontSize="13" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                            </Border>
                                                        </Border>
                                                        <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="12,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Name}" />
                                                        <!-- The last refresh of a public calendar failed: the reason is in the tooltip. -->
                                                        <TextBlock Grid.Column="2" Text="&#xE7BA;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" Foreground="#E37400" FontSize="14"
                                                                   VerticalAlignment="Center" Margin="6,0,2,0" IsVisible="{Binding HasProblem}" ToolTip.Tip="{Binding ProblemText}" />
                                                      </Grid>
                                                    </Button>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <Panel>
        <ctl:MonthGrid Name="Month" DimPast="{Binding Settings.DimPastEvents}" IsVisible="{Binding IsMonth}" Margin="0,0,12,0" ShowWeekends="{Binding ShowWeekends}"
                       GridStart="{Binding MonthGridStart}" Month="{Binding MonthNumber}"
                       Events="{Binding VisibleEvents}" CalendarColors="{Binding CalendarColors}" />

        <ScrollViewer IsVisible="{Binding IsYear}">
            <ctl:YearGrid Name="Year" Year="{Binding YearNumber}" FirstDayOfWeek="{Binding Settings.FirstDayOfWeek}"
                          Events="{Binding VisibleEvents}" Margin="12,0" />
        </ScrollViewer>

        <ScrollViewer IsVisible="{Binding IsAgenda}">
            <ItemsControl ItemsSource="{Binding AgendaDays}" Margin="24,8,24,24" MaxWidth="900">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AgendaDay">
                        <StackPanel Margin="0,0,0,14">
                            <TextBlock Text="{Binding Label}" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ItemsControl ItemsSource="{Binding Items}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="vm:AgendaItem">
                                        <Border Background="Transparent" Padding="8,6" Cursor="Hand" Tapped="OnAgendaItemTapped" DoubleTapped="OnAgendaItemOpened">
                                            <Grid ColumnDefinitions="18,170,*">
                                                <Ellipse Width="10" Height="10" Fill="{Binding ColorHex}" HorizontalAlignment="Left" VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Time}" Classes="muted" />
                                                    <TextBlock Text="{Binding SecondTime}" IsVisible="{Binding HasSecondTime}" Classes="muted" FontSize="11" />
                                                </StackPanel>
                                                <TextBlock Grid.Column="2" Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
        <TextBlock IsVisible="{Binding ShowAgendaEmpty}" Text="{loc:T main.agenda_empty}" Classes="muted"
                   HorizontalAlignment="Center" VerticalAlignment="Center" Name="AgendaEmpty" />

        <DockPanel IsVisible="{Binding IsTimeGrid}">
            <Panel DockPanel.Dock="Top">
            <!-- Above the hours: the offset of this PC and, with a second time zone, the name of its column. -->
            <TextBlock Text="{Binding SecondZoneLabel}" AutomationProperties.AutomationId="Main.SecondZoneLabel" IsVisible="{Binding HasSecondZone}" FontSize="11" FontWeight="SemiBold" Classes="muted" Margin="8,0,0,6" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <TextBlock Text="{Binding TimeZoneLabel}" Classes="muted" FontSize="11" Margin="{Binding TimeZoneLabelMargin}" VerticalAlignment="Bottom" HorizontalAlignment="Left" />
            <ItemsControl ItemsSource="{Binding Days}" Margin="{Binding DaysMargin}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DayHeader">
                        <StackPanel HorizontalAlignment="Center" Spacing="2">
                            <TextBlock Text="{Binding Label}" FontSize="11" HorizontalAlignment="Center" Classes="muted" />
                            <Border Width="40" Height="40" CornerRadius="20" Classes.today="{Binding IsToday}">
                                <Border.Styles>
                                    <Style Selector="Border.today">
                                        <Setter Property="Background" Value="#1A73E8" />
                                    </Style>
                                    <Style Selector="Border.today TextBlock">
                                        <Setter Property="Foreground" Value="White" />
                                    </Style>
                                </Border.Styles>
                                <TextBlock Text="{Binding Number}" FontSize="22" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
            </Panel>
            <ctl:AllDayStrip Name="AllDay" Gutter="{Binding TimeAxisWidth}" DimPast="{Binding Settings.DimPastEvents}" DockPanel.Dock="Top" Margin="0,0,12,0"
                             WeekStart="{Binding WeekStart}" DayCount="{Binding DayCount}"
                             Events="{Binding VisibleEvents}"
                             CalendarColors="{Binding CalendarColors}" />
            <ScrollViewer Name="GridScroll">
                <!-- Same 12px right margin as the day headers and the all-day strip, so the columns line up:
                     the Fluent scrollbar overlays the content instead of taking space, and sits in that margin. -->
                <ctl:WeekGrid Name="Grid" Gutter="{Binding TimeAxisWidth}" SecondZone="{Binding SecondZone}" Margin="0,0,12,0" DimPast="{Binding Settings.DimPastEvents}"
                              WeekStart="{Binding WeekStart}" DayCount="{Binding DayCount}"
                              Events="{Binding VisibleEvents}"
                              CalendarColors="{Binding CalendarColors}"
                              FirstHour="{Binding FirstHour}"
                              LastHour="{Binding LastHour}"
                              Use24Hour="{Binding Settings.Use24HourClock}"
                              SnapMinutes="{Binding Settings.SnapMinutes}"
                              DefaultMinutes="{Binding Settings.DefaultEventMinutes}" />
            </ScrollViewer>
        </DockPanel>


        <!-- Results of the search: they cover the view while the search is open. Like Google Calendar: the day on the left, a line per event, a rule between days. -->
        <Border IsVisible="{Binding Search.ShowResults}" Background="{DynamicResource SearchSurfaceBrush}">
            <Panel>
                <ScrollViewer>
                    <StackPanel Margin="24,0,24,24" MaxWidth="1000">
                        <ItemsControl ItemsSource="{Binding Search.Groups}" AutomationProperties.AutomationId="Search.Results">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:SearchGroup">
                                    <Border BorderThickness="0,0,0,1" BorderBrush="#33808080" Padding="0,10">
                                        <Grid ColumnDefinitions="180,*">
                                            <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Top" Margin="8,2,0,0">
                                                <Border Width="36" Height="36" CornerRadius="18" Classes.today="{Binding IsToday}">
                                                    <Border.Styles>
                                                        <Style Selector="Border.today"><Setter Property="Background" Value="#1A73E8" /></Style>
                                                        <Style Selector="Border.today TextBlock"><Setter Property="Foreground" Value="White" /></Style>
                                                    </Border.Styles>
                                                    <TextBlock Text="{Binding DayNumber}" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                </Border>
                                                <TextBlock Text="{Binding MonthWeekday}" Classes="muted" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            </StackPanel>
                                            <ItemsControl Grid.Column="1" ItemsSource="{Binding Rows}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:SearchRow">
                                                        <Border Classes="searchrow" AutomationProperties.AutomationId="Search.Row" Padding="10,6" CornerRadius="16" Opacity="{Binding RowOpacity}" Background="Transparent"
                                                                Tapped="OnSearchRowTapped" DoubleTapped="OnSearchRowDoubleTapped">
                                                            <Grid ColumnDefinitions="Auto,150,*,Auto">
                                                                <Ellipse Width="12" Height="12" Fill="{Binding ColorHex}" VerticalAlignment="Top" Margin="0,5,12,0" />
                                                                <StackPanel Grid.Column="1" Margin="0,1,8,0">
                                                                    <TextBlock Text="{Binding Time}" />
                                                                    <TextBlock Text="{Binding SecondTime}" IsVisible="{Binding HasSecondTime}" Classes="muted" FontSize="11" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="2" Spacing="1">
                                                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Snippet}" IsVisible="{Binding HasSnippet}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Note}" IsVisible="{Binding HasNote}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" />
                                                                </StackPanel>
                                                                <StackPanel Grid.Column="3" Margin="12,0,0,0" HorizontalAlignment="Right">
                                                                    <TextBlock Text="{Binding Tags}" Classes="muted" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                                    <TextBlock Text="{Binding CalendarName}" Classes="muted" FontSize="11" HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="220" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock Text="{Binding Search.TruncatedNote}" IsVisible="{Binding Search.IsTruncated}" Classes="muted" Margin="8,12" AutomationProperties.AutomationId="Search.Truncated" />
                    </StackPanel>
                </ScrollViewer>
                <TextBlock IsVisible="{Binding Search.ShowMessage}" Text="{Binding Search.Message}" Classes="muted" TextWrapping="Wrap" MaxWidth="480" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.AutomationId="Search.Message" />
            </Panel>
        </Border>

        <!-- Event details shown on a single click, beside the clicked event (content set in code). A click outside closes it
             and still reaches the calendar, so clicking another event opens that one directly. -->
        <Popup Name="DetailsPopup" IsLightDismissEnabled="True" OverlayDismissEventPassThrough="True"
               Placement="RightEdgeAlignedTop" HorizontalOffset="8" PlacementConstraintAdjustment="FlipX,FlipY,SlideX,SlideY" />
        </Panel>
    </DockPanel>
</Window>
