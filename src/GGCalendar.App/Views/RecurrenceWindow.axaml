<Window xmlns:loc="using:GGCalendar.App.Localization" xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:GGCalendar.App.ViewModels"
        x:Class="GGCalendar.App.Views.RecurrenceWindow"
        x:DataType="vm:RecurrenceViewModel"
        Icon="/Assets/GGCalendar.ico"
        Width="460" SizeToContent="Height" CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="{loc:T recurrence.title}">

    <Window.Styles>
        <Style Selector="ToggleButton.day">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="CornerRadius" Value="18" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
    </Window.Styles>

    <StackPanel Margin="28,24,28,20" Spacing="18">
        <TextBlock Text="{loc:T recurrence.title}" FontSize="22" />

        <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{loc:T recurrence.repeat_every}" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding Interval}" Minimum="1" Maximum="999" FormatString="0" Width="110" />
            <ComboBox ItemsSource="{x:Static vm:RecurrenceViewModel.Frequencies}" SelectedItem="{Binding Frequency}" Width="150">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:FrequencyOption"><TextBlock Text="{Binding Label}" /></DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding IsWeekly}">
            <TextBlock Text="{loc:T recurrence.repeats_on}" />
            <ItemsControl ItemsSource="{Binding Days}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="8" /></ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:WeekdayToggle">
                        <ToggleButton Classes="day" Content="{Binding Label}" IsChecked="{Binding IsChecked}" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="10">
            <TextBlock Text="{loc:T recurrence.end}" />
            <RadioButton GroupName="End" Content="{loc:T recurrence.never}" IsChecked="{Binding EndsNever}" />
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton GroupName="End" Content="{loc:T recurrence.on_date}" IsChecked="{Binding EndsOnDate}" Width="90" />
                <CalendarDatePicker SelectedDate="{Binding UntilDate}" IsEnabled="{Binding EndsOnDate}" FirstDayOfWeek="Monday" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="10">
                <RadioButton GroupName="End" Content="{loc:T recurrence.after}" IsChecked="{Binding EndsAfter}" Width="90" />
                <NumericUpDown Value="{Binding Count}" Minimum="1" Maximum="999" FormatString="0" Width="110" IsEnabled="{Binding EndsAfter}" />
                <TextBlock Text="{loc:T recurrence.occurrences}" VerticalAlignment="Center" />
            </StackPanel>
        </StackPanel>

        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right">
            <Button Content="{loc:T common.cancel}" Classes="link" Click="OnCancel" />
            <Button Content="{loc:T recurrence.end}" Classes="accent" CornerRadius="18" Padding="26,8" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
