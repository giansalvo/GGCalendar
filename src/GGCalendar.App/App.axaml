<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="GGCalendar.App.App"
             xmlns:local="using:GGCalendar.App"
             RequestedThemeVariant="Default">
             <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <Application.Resources>
        <!-- The font of the text: AppFonts.Apply replaces it when the person picks another one in the settings. -->
        <FontFamily x:Key="AppFontFamily">fonts:Inter#Inter</FontFamily>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <Style Selector=":is(Window)">
            <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        </Style>
    </Application.Styles>
</Application>